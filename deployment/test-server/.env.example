CHATWOOT_DOMAIN=rc-chatwoot.ru
CHATWOOT_IMAGE_REPOSITORY=ghcr.io/carboninc/chatwoot
CHATWOOT_IMAGE_TAG=replace_with_full_git_sha
FRONTEND_URL=https://rc-chatwoot.ru
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false
SECRET_KEY_BASE=replace_with_128_random_hex_characters
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=replace_with_64_random_hex_characters
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=replace_with_64_random_hex_characters
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=replace_with_64_random_hex_characters
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_test_server
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=replace_with_64_random_hex_characters
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=replace_with_64_random_hex_characters
ACTIVE_STORAGE_SERVICE=local
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2
SIDEKIQ_CONCURRENCY=5
MAILER_SENDER_EMAIL=RC Chatwoot Test <test@rc-chatwoot.ru>
SMTP_ADDRESS=mailpit
SMTP_PORT=1025
SMTP_ENABLE_STARTTLS_AUTO=false
ENABLE_PUSH_RELAY_SERVER=false
